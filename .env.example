# ATIP Local Environment Configuration Example (NO SECRETS)
# Duplicate to .env for local development

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ENABLE_DEMO_FIXTURES=true

# Backend Core & Database
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://atip:atippass@localhost:5432/atip_db
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Object Storage (MinIO / S3 compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=atip_storage_dev
STORAGE_SECRET_KEY=atip_storage_secret_dev
STORAGE_BUCKET_ARTIFACTS=atip-artifacts

# Authentication (OIDC)
OIDC_ISSUER_URL=http://localhost:8000/auth
OIDC_CLIENT_ID=atip-web-client
JWT_SECRET_KEY=dev_insecure_jwt_secret_change_in_production_32bytes_minimum

# GitHub App Integration (Configure via Settings > GitHub)
GITHUB_APP_ID=
GITHUB_APP_SLUG=atip-local-dev
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=

# AI Provider Gateway (Optional - user supplied via Settings or env)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Execution Sandbox Policy
SANDBOX_BACKEND=docker
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_CPU_LIMIT=2.0
