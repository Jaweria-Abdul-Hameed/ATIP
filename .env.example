# ATIP Local Environment Configuration Example (NO SECRETS)
# Duplicate to .env for local development

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ENABLE_DEMO_FIXTURES=false

# Backend Core & Environment
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production-atip-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL (Authoritative System of Record)
DATABASE_URL=postgresql+asyncpg://atip:atip_dev_password@localhost:5432/atip_db
DATABASE_ECHO=false
POSTGRES_DB=atip_db
POSTGRES_USER=atip
POSTGRES_PASSWORD=atip_dev_password

# Redis (Ephemeral Cache & Fast Status)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (Durable Messaging & Transactional Outbox)
RABBITMQ_URL=amqp://atip:atip_dev_password@localhost:5672/
RABBITMQ_USER=atip
RABBITMQ_PASS=atip_dev_password

# S3 Object Storage (MinIO local artifacts & logs)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=atipadmin
S3_SECRET_ACCESS_KEY=atipsecretpassword
S3_BUCKET_NAME=atip-artifacts
S3_REGION=us-east-1
MINIO_ROOT_USER=atipadmin
MINIO_ROOT_PASSWORD=atipsecretpassword

# CORS Allowlist
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Authentication (OIDC)
OIDC_ISSUER_URL=http://localhost:8000/auth
OIDC_CLIENT_ID=atip-web-client

# GitHub App Integration (Configure via Settings > GitHub)
GITHUB_APP_ID=
GITHUB_APP_SLUG=atip-local-dev
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=

# AI Provider Gateway (User supplied via Settings or env)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Execution Sandbox Policy
SANDBOX_BACKEND=docker
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_CPU_LIMIT=2.0
